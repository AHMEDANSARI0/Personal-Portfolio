{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node -e \"const{existsSync}=require('fs');if(existsSync('prisma/schema.prisma'))require('child_process').execSync('npx prisma generate',{stdio:'inherit'})\"",
    "prisma:generate": "prisma generate",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:db": "node scripts/start-dev-db.mjs",
    "build": "prisma generate && next build && node scripts/postbuild-standalone.mjs",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f infra/docker-compose.yml up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "admin:password": "tsx scripts/set-admin-password.ts",
    "avatar:placeholder": "tsx scripts/make-placeholder-avatar.ts",
    "avatar:optimize": "npx @gltf-transform/cli optimize uploads/model/avatar.glb uploads/model/avatar-compressed.glb --compress draco --texture-compress webp",
    "assets:placeholder": "tsx scripts/make-placeholder-assets.ts",
    "test:smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "next": "^16.3.4",
    "nodemailer": "^10.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.186.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "^0.185.4",
    "embedded-postgres": "17.10.0-beta.17",
    "postcss": "^8.5.28",
    "prisma": "6.16.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}